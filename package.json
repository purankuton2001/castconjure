{
  "name": "castconjure",
  "version": "0.1.0",
  "description": "Your own virtual idol, generated \u2014 not lip-synced. Chat makes her dance, eat, talk and change scenes, live on your stream. OSS, BYOK.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "gen:once": "tsx src/cli/gen-once.ts",
    "probe": "tsx src/cli/probe.ts",
    "probe:voice": "tsx src/cli/probe-voice.ts",
    "idle": "tsx src/cli/idle-pool.ts",
    "record:live": "node scripts/record-live.mjs",
    "persona:import": "tsx src/cli/persona-import.ts",
    "voice:gacha": "tsx src/cli/voice-gacha.ts",
    "ack": "tsx src/cli/ack-pool.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "playwright": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "ai-vtuber",
    "vtuber",
    "virtual-idol",
    "text-to-video",
    "minimax",
    "h3",
    "fal",
    "obs",
    "youtube-live",
    "livestream",
    "generative-video"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/purankuton2001/castconjure"
  },
  "homepage": "https://github.com/purankuton2001/castconjure#readme"
}
