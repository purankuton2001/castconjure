# ── castconjure ────────────────────────────────────────────────────────────────
# Copy to .env. Everything here stays on your machine (BYOK). Never commit .env.

# Local server port (config UI + OBS overlay)
PORT=8787

# ── Generation backend: mock | fal | local ─────────────────────────────────────
# mock  = $0, renders a text card in the overlay (use this first)
# fal   = MiniMax H3 Max on fal.ai (needs FAL_KEY; you pay fal directly)
# local = ComfyUI with open-weights H3 (pre-generation mode, ~50s/clip on a 4090)
BACKEND=mock
FAL_KEY=
# Endpoint IDs (change only if fal renames them)
FAL_T2V_MODEL=minimax/h3-max/text-to-video
FAL_R2V_MODEL=minimax/h3-max/reference-to-video
# balanced (~1s) | quality (~30s, defeats the purpose of realtime)
FAL_PROMPT_EXPANSION=balanced
# Download fal clips to data/clips so OBS never hits an expired CDN URL
CACHE_CLIPS=true
# Local backend
COMFY_URL=http://127.0.0.1:8188
COMFY_WORKFLOW=./local/workflow.json

# ── Chat platform: manual | youtube ────────────────────────────────────────────
PLATFORM=manual
# YouTube Data API v3 key from your own Google Cloud project (no OAuth needed for public live chat)
YOUTUBE_API_KEY=
# The live video's ID (the v= parameter). Can also be set from the config UI.
YOUTUBE_VIDEO_ID=
# Estimated quota units per liveChatMessages.list call (used for the on-screen estimate only)
YOUTUBE_UNITS_PER_POLL=5
# Never poll faster than the API's pollingIntervalMillis; this only lets you poll slower (ms)
YOUTUBE_MIN_POLL_MS=0

# ── Defaults for runtime settings (all editable in the config UI) ──────────────
RESOLUTION=480p
DURATION_SEC=5
AUDIO=false
WORLD_PROMPT=A whimsical, colorful animated world. Cinematic lighting, smooth motion, no text on screen.
CHARACTER_NAME=
CHARACTER_DESCRIPTION=
CHARACTER_FORBIDDEN=
# Files in data/characters/ or URLs, comma separated, max 3. Your own character only.
CHARACTER_REFERENCE_IMAGES=
MIN_INTERVAL_SEC=30
USER_COOLDOWN_SEC=120
# Only react to comments starting with this (e.g. !gen). Empty = every comment.
COMMAND_PREFIX=
APPROVAL_MODE=false
APPROVE_COMMAND=!ok
NG_WORDS=
# Hard stop per session, USD. fal also lets you set a monthly spend cap — set both.
BUDGET_USD=20
SHOW_AI_BADGE=true
MAX_COMMENT_CHARS=120
MAX_QUEUE=5

# ── Advanced ───────────────────────────────────────────────────────────────────
MAX_CONCURRENT_GEN=1
GEN_TIMEOUT_MS=120000
# Start the pipeline immediately on boot (otherwise press Start in the config UI)
AUTOSTART=0
