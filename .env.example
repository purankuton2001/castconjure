# ── castconjure ────────────────────────────────────────────────────────────────
# Copy to .env. Everything here stays on your machine (BYOK). Never commit .env.

# Local server port (config UI + OBS overlay)
PORT=8787

# ── Generation backend: mock | fal | local ─────────────────────────────────────
# mock  = $0, renders a text card in the overlay (use this first)
# fal   = MiniMax H3 Max on fal.ai (needs FAL_KEY; you pay fal directly)
# local = ComfyUI with open-weights H3 (pre-generation mode, ~50s/clip on a 4090)
BACKEND=mock
FAL_KEY=
# Endpoint IDs (change only if fal renames them)
FAL_T2V_MODEL=minimax/h3-max/text-to-video
FAL_R2V_MODEL=minimax/h3-max/reference-to-video
# Persona creation (F-10/F-11): image + TTS models on fal. auto = fal when FAL_KEY is set, else mock
PERSONA_IMAGES=auto
FAL_IMAGE_MODEL=fal-ai/flux/dev
FAL_IMAGE_EDIT_MODEL=fal-ai/flux-pro/kontext
FAL_TTS_MODEL=fal-ai/minimax/speech-02-hd
# Extra JSON merged into the TTS request (voice id etc.), e.g. {"voice_setting":{"voice_id":"Wise_Woman"}}
FAL_TTS_EXTRA={}
# balanced (~1s) | quality (~30s, defeats the purpose of realtime)
FAL_PROMPT_EXPANSION=balanced
# Download fal clips to data/clips so OBS never hits an expired CDN URL
CACHE_CLIPS=true
# Local backend
COMFY_URL=http://127.0.0.1:8188
COMFY_WORKFLOW=./local/workflow.json

# ── Chat platform: manual | youtube ────────────────────────────────────────────
PLATFORM=manual
# YouTube Data API v3 key from your own Google Cloud project (no OAuth needed for public live chat)
YOUTUBE_API_KEY=
# The live video's ID (the v= parameter). Can also be set from the config UI.
YOUTUBE_VIDEO_ID=
# Estimated quota units per liveChatMessages.list call (used for the on-screen estimate only)
YOUTUBE_UNITS_PER_POLL=5
# Never poll faster than the API's pollingIntervalMillis; this only lets you poll slower (ms)
YOUTUBE_MIN_POLL_MS=0

# ── Defaults for runtime settings (all editable in the config UI) ──────────────
RESOLUTION=480p
DURATION_SEC=5
AUDIO=false
# Per-stream world prompt. Empty = the persona's default
WORLD_PROMPT=
# Active persona (folder name under data/personas/). Templates in personas/ are seeded on first boot.
PERSONA_ID=shirotsume-yui
# Reply mode (F-14): the persona answers each comment in one line. mock | anthropic | gemini | openai (BYOK)
REPLY_MODE=false
REPLY_PROVIDER=mock
REPLY_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Idle pool (F-13): number of 5-second idle clips to pre-generate for the persona
IDLE_POOL_SIZE=12
MIN_INTERVAL_SEC=30
USER_COOLDOWN_SEC=120
# Only react to comments starting with this (e.g. !gen). Empty = every comment.
COMMAND_PREFIX=
APPROVAL_MODE=false
APPROVE_COMMAND=!ok
NG_WORDS=
# Hard stop per session, USD. fal also lets you set a monthly spend cap — set both.
BUDGET_USD=20
SHOW_AI_BADGE=true
MAX_COMMENT_CHARS=120
MAX_QUEUE=5

# ── Advanced ───────────────────────────────────────────────────────────────────
MAX_CONCURRENT_GEN=1
GEN_TIMEOUT_MS=120000
# Speed vs consistency per reaction clip: face (≈9 s) | face+scene (≈10 s, default) | all (≈13 s). Idle pool always uses all.
REF_MODE=face+scene
# Send the reference voice with each clip (same voice every time, ≈ +6 s). Off = H3 picks a voice per clip.
VOICE_REF=true
# Instant reply: subtitle immediately, TTS of the line in parallel with generation
INSTANT_REPLY=true
# fal.run synchronous endpoint (measured 7–10 s slower for H3 Max) — keep off
FAL_SYNC=false
# Start the pipeline immediately on boot (otherwise press Start in the config UI)
AUTOSTART=0
